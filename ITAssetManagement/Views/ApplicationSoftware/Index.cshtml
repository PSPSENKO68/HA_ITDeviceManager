@model IEnumerable<ITAssetManagement.Models.UserAppGroupViewModel>

@{
    ViewData["Title"] = "Phần mềm cài đặt";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string currentLoai = ViewBag.CurrentLoai ?? "All";
    var rawList = ViewBag.AllRawList as List<ITAssetManagement.Models.ApplicationSoftware> ?? new List<ITAssetManagement.Models.ApplicationSoftware>();
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-app-indicator me-2 text-primary"></i>Danh mục Phần mềm & Ứng dụng
        </h3>
        <p class="text-muted small mb-0">Quản lý phần mềm cài đặt theo từng nhân sự, bản quyền và ứng dụng nghiệp vụ</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm phần mềm mới
        </a>
    </div>
</div>

<!-- Apple Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-app"></i>
            </div>
            <div>
                <div class="stat-label">Tổng phần mềm đã cài</div>
                <div class="stat-value">@ViewBag.TotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <div class="stat-label">Nhân sự có phần mềm</div>
                <div class="stat-value" style="color: var(--color-purple);">@ViewBag.TotalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="stat-label">Bản quyền (License)</div>
                <div class="stat-value text-primary">@ViewBag.LicensedCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-activity"></i>
            </div>
            <div>
                <div class="stat-label">Đang hoạt động / Dùng</div>
                <div class="stat-value text-success">@ViewBag.ActiveCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" 
                           placeholder="Tìm Tên nhân sự, Tên máy, Phần mềm, Phòng ban..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="loaiPhanMem" class="form-select form-select-sm">
                    <option value="All" selected="@(currentLoai == "All")">-- Tất cả loại phần mềm --</option>
                    <option value="Bản quyền" selected="@(currentLoai == "Bản quyền")">Bản quyền</option>
                    <option value="Miễn phí" selected="@(currentLoai == "Miễn phí")">Miễn phí</option>
                    <option value="Nội bộ" selected="@(currentLoai == "Nội bộ")">Nội bộ</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentLoai != "All")
                {
                    <a asp-action="Index" class="btn btn-sm btn-light border text-muted ms-1">Đặt lại</a>
                }
            </div>
            <div class="col text-end">
                <ul class="nav nav-pills d-inline-flex bg-light p-1 rounded-pill" id="viewTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-1 px-3 btn-sm rounded-pill" id="user-view-tab" data-bs-toggle="pill" data-bs-target="#user-view" type="button" role="tab" style="font-size: 12px;">
                            <i class="bi bi-people-fill me-1"></i> Gom nhóm Nhân sự
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-1 px-3 btn-sm rounded-pill" id="raw-view-tab" data-bs-toggle="pill" data-bs-target="#raw-view" type="button" role="tab" style="font-size: 12px;">
                            <i class="bi bi-list-ul me-1"></i> Xem bảng phẳng
                        </button>
                    </li>
                </ul>
            </div>
        </form>
    </div>
</div>

<div class="tab-content" id="viewTabContent">
    <!-- VIEW GOM NHÓM THEO USER VỚI KHẢ NĂNG SỔ XUỐNG -->
    <div class="tab-pane fade show active" id="user-view" role="tabpanel">
        @if (!Model.Any())
        {
            <div class="card border-0 p-5 text-center text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                <p class="mb-0">Không tìm thấy phần mềm hoặc nhân sự nào phù hợp.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="accordionUserApps">
                @{ int groupIdx = 0; }
                @foreach (var userGroup in Model)
                {
                    groupIdx++;
                    string collapseId = $"collapseUser_{groupIdx}";
                    string headingId = $"headingUser_{groupIdx}";
                    <div class="card border-0 mb-3 overflow-hidden">
                        <div class="card-body p-3" id="@headingId">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center flex-grow-1 cursor-pointer" 
                                     data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" 
                                     style="cursor: pointer;">
                                    <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3 border border-primary-subtle" 
                                         style="width: 42px; height: 42px; font-weight: 700; font-size: 1rem;">
                                        @(userGroup.Owner.Length > 0 ? userGroup.Owner.Substring(0, 1).ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                            <span>@userGroup.Owner</span>
                                            <span class="badge rounded-pill bg-primary-subtle text-primary">@userGroup.Apps.Count phần mềm</span>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            @if (!string.IsNullOrEmpty(userGroup.PhongBan))
                                            {
                                                <span class="me-3"><i class="bi bi-building me-1"></i>@userGroup.PhongBan</span>
                                            }
                                            @if (!string.IsNullOrEmpty(userGroup.May))
                                            {
                                                <span><i class="bi bi-laptop me-1"></i>Máy: <span class="fw-semibold text-dark">@userGroup.May</span></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Create" 
                                       asp-route-userId="@userGroup.UserId" 
                                       asp-route-owner="@userGroup.Owner" 
                                       asp-route-phongBan="@userGroup.PhongBan" 
                                       asp-route-may="@userGroup.May" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-plus-lg me-1"></i> Cài thêm PM
                                    </a>
                                    <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                                        <i class="bi bi-chevron-down"></i> Chi tiết
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Danh sách chi tiết sổ xuống -->
                        <div id="@collapseId" class="collapse" aria-labelledby="@headingId" data-bs-parent="#accordionUserApps">
                            <div class="border-top">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 bg-white">
                                        <thead>
                                            <tr>
                                                <th class="ps-4" style="width: 50px;">STT</th>
                                                <th>Ứng dụng / Phần mềm</th>
                                                <th>Loại phần mềm</th>
                                                <th>Trạng thái</th>
                                                <th>Ngày cài đặt</th>
                                                <th>Lý do cài đặt</th>
                                                <th>Ghi chú</th>
                                                <th class="actions-col pe-4">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int appIdx = 0; }
                                            @foreach (var app in userGroup.Apps)
                                            {
                                                appIdx++;
                                                <tr>
                                                    <td class="ps-4 text-muted fw-semibold">@appIdx</td>
                                                    <td>
                                                        <div class="fw-semibold text-dark">
                                                            <i class="bi bi-app me-1 text-primary"></i>@app.UngDung
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (app.LoaiPhanMem != null && app.LoaiPhanMem.Contains("quyền"))
                                                        {
                                                            <span class="badge bg-purple-subtle text-purple">
                                                                <i class="bi bi-shield-check me-1"></i>Bản quyền
                                                            </span>
                                                        }
                                                        else if (app.LoaiPhanMem != null && app.LoaiPhanMem.Contains("phí"))
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary">
                                                                <i class="bi bi-gift me-1"></i>Miễn phí
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary">@(app.LoaiPhanMem ?? "Nội bộ")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (app.TrangThai == "Đang sử dụng" || app.TrangThai == "Active")
                                                        {
                                                            <span class="badge bg-success-subtle text-success">
                                                                <i class="bi bi-check-circle me-1"></i>Đang sử dụng
                                                            </span>
                                                        }
                                                        else if (app.TrangThai == "Đã gỡ bỏ")
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger">
                                                                <i class="bi bi-x-circle me-1"></i>Đã gỡ bỏ
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning">
                                                                <i class="bi bi-exclamation-triangle me-1"></i>@(app.TrangThai ?? "Cần kiểm tra")
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="font-monospace text-muted small">@(app.NgayCaiDat ?? "—")</span>
                                                    </td>
                                                    <td class="text-muted small">@(app.LyDo ?? "—")</td>
                                                    <td class="text-muted small">@(app.GhiChu ?? "—")</td>
                                                    <td class="actions-col pe-4">
                                                        <div class="table-actions">
                                                            <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-light border" title="Chỉnh sửa">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                            <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary" title="Chi tiết">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            <a asp-action="Delete" asp-route-id="@app.Id" class="btn btn-light border text-danger" title="Xóa">
                                                                <i class="bi bi-trash"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- VIEW BẢNG PHẲNG -->
    <div class="tab-pane fade" id="raw-view" role="tabpanel">
        <div class="card border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 50px;">STT</th>
                                <th>Người sử dụng</th>
                                <th>Phòng ban</th>
                                <th>Tên máy</th>
                                <th>Ứng dụng / Phần mềm</th>
                                <th>Loại phần mềm</th>
                                <th>Trạng thái</th>
                                <th>Ngày cài đặt</th>
                                <th class="actions-col pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rawIdx = 0; }
                            @foreach (var item in rawList)
                            {
                                rawIdx++;
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">@rawIdx</td>
                                    <td class="fw-semibold text-dark">@(item.Owner ?? "—")</td>
                                    <td><span class="badge bg-light text-secondary border">@(item.PhongBan ?? "—")</span></td>
                                    <td><span class="font-monospace text-dark">@(item.May ?? "—")</span></td>
                                    <td>
                                        <i class="bi bi-app me-1 text-primary"></i><strong>@item.UngDung</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary">@(item.LoaiPhanMem ?? "Nội bộ")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">@(item.TrangThai ?? "Đang dùng")</span>
                                    </td>
                                    <td><span class="font-monospace text-muted small">@(item.NgayCaiDat ?? "—")</span></td>
                                    <td class="actions-col pe-4">
                                        <div class="table-actions">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light border" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light border text-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
