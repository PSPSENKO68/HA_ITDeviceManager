@model ITAssetManagement.Models.ApplicationSoftware

@{
    ViewData["Title"] = "Chỉnh sửa Phần mềm / Ứng dụng";
    var users = ViewBag.Users as List<ITAssetManagement.Models.User> ?? new List<ITAssetManagement.Models.User>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Phần mềm: @Model.UngDung
                    </h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Stt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gán cho Nhân sự (Users)</label>
                            <select asp-for="UserId" class="form-select" id="userSelect" onchange="onUserChanged()">
                                <option value="">-- Chọn nhân sự (Tùy chọn) --</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" data-fullname="@u.FullName" data-dept="@u.Department" selected="@(Model.UserId == u.Id)">
                                        @u.FullName (@u.Username) - @u.Department
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Owner" class="form-label fw-semibold">Người sử dụng (Owner) <span class="text-danger">*</span></label>
                            <input asp-for="Owner" class="form-control" id="ownerInput" required />
                            <span asp-validation-for="Owner" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhongBan" class="form-label fw-semibold">Phòng ban / Bộ phận</label>
                            <input asp-for="PhongBan" class="form-control" id="deptInput" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="May" class="form-label fw-semibold">Tên máy cài đặt</label>
                            <input asp-for="May" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="UngDung" class="form-label fw-semibold">Tên phần mềm / Ứng dụng <span class="text-danger">*</span></label>
                            <input asp-for="UngDung" class="form-control" required />
                            <span asp-validation-for="UngDung" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="LoaiPhanMem" class="form-label fw-semibold">Loại phần mềm</label>
                            <select asp-for="LoaiPhanMem" class="form-select">
                                <option value="Bản quyền">Bản quyền</option>
                                <option value="Miễn phí">Miễn phí</option>
                                <option value="Nội bộ">Nội bộ</option>
                                <option value="Thử nghiệm">Thử nghiệm</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="TrangThai" class="form-label fw-semibold">Trạng thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Đang sử dụng">Đang sử dụng</option>
                                <option value="Cần kiểm tra">Cần kiểm tra</option>
                                <option value="Đã gỡ bỏ">Đã gỡ bỏ</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="NgayCaiDat" class="form-label fw-semibold">Ngày cài đặt (mm/dd/yyyy)</label>
                            <input asp-for="NgayCaiDat" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="LyDo" class="form-label fw-semibold">Lý do cài đặt</label>
                            <input asp-for="LyDo" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú bổ sung</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Cập nhật thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onUserChanged() {
            var select = document.getElementById('userSelect');
            var selectedOption = select.options[select.selectedIndex];
            if (selectedOption && selectedOption.value) {
                var name = selectedOption.getAttribute('data-fullname');
                var dept = selectedOption.getAttribute('data-dept');
                if (name) document.getElementById('ownerInput').value = name;
                if (dept) document.getElementById('deptInput').value = dept;
            }
        }
    </script>
}

