@model ITAssetManagement.Models.ThietBi

@{
    ViewData["Title"] = "Xác nhận xóa thiết bị";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">Bạn có chắc chắn muốn xóa thiết bị này?</h4>
                <p class="text-muted">Hành động này sẽ xóa vĩnh viễn thiết bị khỏi cơ sở dữ liệu ITAssetDB.</p>

                <div class="bg-light p-3 rounded-3 text-start my-3">
                    <div class="mb-1"><strong>Model:</strong> @Model.Model</div>
                    <div class="mb-1"><strong>Serial:</strong> <span class="font-monospace">@Model.SerialNumber</span></div>
                    <div class="mb-1"><strong>Nhóm:</strong> @Model.NhomThietBi</div>
                    <div><strong>Người dùng:</strong> @(Model.Owner ?? "—")</div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2 mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

