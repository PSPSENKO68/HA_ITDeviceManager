@model IEnumerable<ITAssetManagement.Models.User>

@{
    ViewData["Title"] = "Nhân sự & Người dùng";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string currentRole = ViewBag.CurrentRole ?? "All";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-people me-2 text-primary"></i>Danh mục Nhân sự & Người dùng
        </h3>
        <p class="text-muted small mb-0">Quản lý hồ sơ nhân viên, phân quyền IT và liên kết tài sản máy tính, license, phần mềm</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm nhân sự mới
        </a>
    </div>
</div>

<!-- Apple Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="stat-label">Tổng nhân sự trong CSDL</div>
                <div class="stat-value">@ViewBag.TotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="stat-label">Đang hoạt động (Active)</div>
                <div class="stat-value text-success">@ViewBag.ActiveCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="stat-label">Tài khoản Quản trị (Admin/IT)</div>
                <div class="stat-value" style="color: var(--color-purple);">
                    @Model.Count(u => u.Role == "Admin" || u.Role == "IT Support")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" 
                           placeholder="Tìm Username, Họ tên, Email, Phòng ban..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select form-select-sm">
                    <option value="All">-- Tất cả vai trò --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(currentRole == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentRole != "All")
                {
                    <a asp-action="Index" class="btn btn-sm btn-light border text-muted ms-1">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Table Card -->
<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 60px;">ID</th>
                        <th>Họ và tên</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phòng ban</th>
                        <th>Chức danh</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="actions-col pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                Không tìm thấy nhân sự nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">@u.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@u.Id" class="fw-semibold text-dark text-decoration-none d-flex align-items-center gap-2">
                                        <div class="avatar bg-light text-primary rounded-circle d-flex align-items-center justify-content-center border" style="width: 28px; height: 28px; font-size: 11px; font-weight: 700;">
                                            @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "?")
                                        </div>
                                        <span>@u.FullName</span>
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border"><i class="bi bi-person me-1 text-muted"></i>@u.Username</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(u.Email))
                                    {
                                        <a href="mailto:@u.Email" class="text-decoration-none small text-muted">@u.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(u.Department ?? "—")</span>
                                </td>
                                <td class="small text-muted">@(u.Position ?? "—")</td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-shield-lock me-1"></i>Admin</span>
                                    }
                                    else if (u.Role == "IT Support")
                                    {
                                        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-headset me-1"></i>IT Support</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@(u.Role ?? "User")</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive == true)
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Locked</span>
                                    }
                                </td>
                                <td class="actions-col pe-4">
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Hồ sơ tài sản">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-light border" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-light border text-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
