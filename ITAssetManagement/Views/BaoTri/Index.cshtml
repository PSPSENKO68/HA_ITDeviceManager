@model IEnumerable<ITAssetManagement.Models.LichSuBaoTri>

@{
    ViewData["Title"] = "Bảo trì & Sửa chữa";
    string currentViewMode = ViewBag.CurrentViewMode ?? "table";
    string currentTrangThai = ViewBag.CurrentTrangThai ?? "All";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    int selMonth = ViewBag.SelectedMonth ?? DateTime.Now.Month;
    int selYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    var allCalendarRecords = ViewBag.AllCalendarRecords as List<ITAssetManagement.Models.LichSuBaoTri> ?? new List<ITAssetManagement.Models.LichSuBaoTri>();

    DateTime? TryParseDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr)) return null;
        string[] formats = { "yyyy-MM-dd", "M/d/yyyy", "MM/dd/yyyy", "d/M/yyyy", "dd/MM/yyyy", "yyyy/MM/dd" };
        if (DateTime.TryParseExact(dateStr.Trim(), formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
        {
            return dt;
        }
        if (DateTime.TryParse(dateStr.Trim(), out dt))
        {
            return dt;
        }
        return null;
    }

    // Prev / Next month calculations
    var curMonthDate = new DateTime(selYear, selMonth, 1);
    var prevMonthDate = curMonthDate.AddMonths(-1);
    var nextMonthDate = curMonthDate.AddMonths(1);
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-tools me-2 text-primary"></i>Kế hoạch & Lịch bảo trì
        </h3>
        <p class="text-muted small mb-0">Quản lý toàn diện lịch bảo trì định kỳ, sự cố kỹ thuật và chi phí sửa chữa tài sản IT</p>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <!-- View Mode Switcher -->
        <div class="btn-group p-1 bg-white border rounded-pill shadow-xs">
            <a asp-action="Index" asp-route-viewMode="table" asp-route-trangThai="@currentTrangThai" asp-route-search="@currentSearch"
               class="btn btn-sm rounded-pill @(currentViewMode == "table" ? "btn-primary shadow-xs" : "btn-light text-muted border-0") px-3">
                <i class="bi bi-table me-1"></i> Danh sách
            </a>
            <a asp-action="Index" asp-route-viewMode="calendar" asp-route-trangThai="@currentTrangThai" asp-route-month="@selMonth" asp-route-year="@selYear"
               class="btn btn-sm rounded-pill @(currentViewMode == "calendar" ? "btn-primary shadow-xs" : "btn-light text-muted border-0") px-3">
                <i class="bi bi-calendar3 me-1"></i> Lịch bảo trì
            </a>
        </div>

        <!-- Add Button -->
        <a asp-action="Create" class="btn btn-sm btn-primary d-inline-flex align-items-center px-3 py-2 rounded-3 shadow-xs">
            <i class="bi bi-plus-lg me-1"></i> Lập kế hoạch mới
        </a>
    </div>
</div>

<!-- Apple Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-viewMode="@currentViewMode" asp-route-trangThai="All" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == "All" ? "border-primary" : "")">
                <div class="stat-icon blue">
                    <i class="bi bi-card-checklist"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng số bảo trì</div>
                    <div class="stat-value">@ViewBag.TotalCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-viewMode="@currentViewMode" asp-route-trangThai="Kế hoạch" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == "Kế hoạch" ? "border-warning" : "")">
                <div class="stat-icon amber">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <div class="stat-label">Kế hoạch chờ làm</div>
                    <div class="stat-value text-warning">@ViewBag.PlanCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-viewMode="@currentViewMode" asp-route-trangThai="Hoàn thành" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == "Hoàn thành" ? "border-success" : "")">
                <div class="stat-icon green">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="stat-label">Đã hoàn tất</div>
                    <div class="stat-value text-success">@ViewBag.DoneCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="stat-label">Tổng chi phí</div>
                <div class="stat-value text-dark" style="font-size: 1.25rem;">
                    @string.Format("{0:N0} đ", ViewBag.TotalCost)
                </div>
            </div>
        </div>
    </div>
</div>

@if (currentViewMode == "calendar")
{
    <!-- CALENDAR VIEW -->
    <div class="card border-0 shadow-xs mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-calendar-month text-primary me-2"></i>Tháng @selMonth, @selYear
                </h5>
                <span class="badge bg-light text-muted border">
                    @(allCalendarRecords.Count(r => {
                        var d = TryParseDate(r.NgayDuKien) ?? TryParseDate(r.NgayThucHien);
                        return d.HasValue && d.Value.Month == selMonth && d.Value.Year == selYear;
                    })) sự kiện trong tháng
                </span>
            </div>

            <!-- Month Controls -->
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" asp-route-viewMode="calendar" asp-route-month="@prevMonthDate.Month" asp-route-year="@prevMonthDate.Year"
                   class="btn btn-sm btn-outline-secondary px-2" title="Tháng trước">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <a asp-action="Index" asp-route-viewMode="calendar" asp-route-month="@DateTime.Now.Month" asp-route-year="@DateTime.Now.Year"
                   class="btn btn-sm btn-light border px-3">
                    Hôm nay
                </a>
                <a asp-action="Index" asp-route-viewMode="calendar" asp-route-month="@nextMonthDate.Month" asp-route-year="@nextMonthDate.Year"
                   class="btn btn-sm btn-outline-secondary px-2" title="Tháng sau">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <!-- Calendar Grid -->
            @{
                int daysInMonth = DateTime.DaysInMonth(selYear, selMonth);
                var firstDayOfMonth = new DateTime(selYear, selMonth, 1);
                // In C#, DayOfWeek: Sunday = 0, Monday = 1 ... Saturday = 6
                // For Monday-based calendar: Mon = 0, Tue = 1 ... Sun = 6
                int startOffset = ((int)firstDayOfMonth.DayOfWeek + 6) % 7;
                var today = DateTime.Today;
            }

            <div class="table-responsive">
                <table class="table table-bordered mb-0 calendar-table" style="table-layout: fixed;">
                    <thead>
                        <tr class="text-center bg-light text-muted small text-uppercase">
                            <th style="width: 14.28%;">Thứ Hai</th>
                            <th style="width: 14.28%;">Thứ Ba</th>
                            <th style="width: 14.28%;">Thứ Tư</th>
                            <th style="width: 14.28%;">Thứ Năm</th>
                            <th style="width: 14.28%;">Thứ Sáu</th>
                            <th style="width: 14.28%;" class="text-primary">Thứ Bảy</th>
                            <th style="width: 14.28%;" class="text-danger">Chủ Nhật</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int currentDay = 1;
                            int totalSlots = ((startOffset + daysInMonth + 6) / 7) * 7;
                        }

                        @for (int slot = 0; slot < totalSlots; slot++)
                        {
                            if (slot % 7 == 0)
                            {
                                @:<tr style="min-height: 110px;">
                            }

                            if (slot < startOffset || currentDay > daysInMonth)
                            {
                                <td class="bg-light bg-opacity-25 text-muted align-top p-2" style="height: 110px;"></td>
                            }
                            else
                            {
                                var cellDate = new DateTime(selYear, selMonth, currentDay);
                                bool isToday = (cellDate == today);

                                // Find records for this specific day
                                var dayRecords = allCalendarRecords.Where(r => {
                                    var d = TryParseDate(r.NgayDuKien) ?? TryParseDate(r.NgayThucHien);
                                    return d.HasValue && d.Value.Date == cellDate.Date;
                                }).ToList();

                                <td class="align-top p-2 @(isToday ? "bg-primary bg-opacity-10" : "")" style="height: 110px; position: relative;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-bold @(isToday ? "badge rounded-circle bg-primary text-white" : "text-muted")" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">
                                            @currentDay
                                        </span>
                                        @if (dayRecords.Any())
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">@dayRecords.Count việc</span>
                                        }
                                    </div>

                                    <div class="d-flex flex-column gap-1 overflow-auto" style="max-height: 75px;">
                                        @foreach (var rec in dayRecords)
                                        {
                                            string badgeBg = rec.TrangThai == "Hoàn thành" ? "bg-success text-white" : (rec.TrangThai == "Đang xử lý" ? "bg-info text-white" : "bg-warning text-dark");
                                            <a asp-action="Details" asp-route-id="@rec.Id" 
                                               class="text-decoration-none badge @badgeBg text-truncate text-start py-1 px-2 fw-normal" 
                                               style="font-size: 11px; display: block;" 
                                               title="@(rec.TieuDe ?? rec.LoaiHanhDong) - @(rec.Model ?? rec.SerialNumber) (@rec.TrangThai)">
                                                <i class="bi @(rec.TrangThai == "Hoàn thành" ? "bi-check2" : "bi-clock") me-1"></i>
                                                <strong>@(rec.Model ?? "Thiết bị"):</strong> @(rec.TieuDe ?? rec.LoaiHanhDong)
                                            </a>
                                        }
                                    </div>
                                </td>
                                currentDay++;
                            }

                            if (slot % 7 == 6)
                            {
                                @:</tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3 small">
                <span class="d-flex align-items-center gap-1">
                    <span class="badge bg-warning text-dark px-2 py-1">Kế hoạch</span> Chờ thực hiện
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span class="badge bg-info text-white px-2 py-1">Đang xử lý</span> Đang bảo trì
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span class="badge bg-success text-white px-2 py-1">Hoàn thành</span> Đã nghiệm thu
                </span>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-sm btn-link text-decoration-none text-primary">
                    <i class="bi bi-plus-circle me-1"></i> Thêm việc bảo trì vào tháng này
                </a>
            </div>
        </div>
    </div>
}
else
{
    <!-- TABLE VIEW -->
    <!-- Filter & Search Bar -->
    <div class="card border-0 mb-3 shadow-xs">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <input type="hidden" name="viewMode" value="table" />
                <input type="hidden" name="trangThai" value="@currentTrangThai" />

                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" 
                               placeholder="Tìm theo Model, Serial, Tiêu đề, Kỹ thuật viên, Linh kiện..." value="@currentSearch" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-muted me-1">Trạng thái:</span>
                        <select name="trangThai" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="All" selected="@(currentTrangThai == "All")">Tất cả (@ViewBag.TotalCount)</option>
                            <option value="Kế hoạch" selected="@(currentTrangThai == "Kế hoạch")">Kế hoạch (@ViewBag.PlanCount)</option>
                            <option value="Đang xử lý" selected="@(currentTrangThai == "Đang xử lý")">Đang xử lý (@ViewBag.InProgressCount)</option>
                            <option value="Hoàn thành" selected="@(currentTrangThai == "Hoàn thành")">Hoàn thành (@ViewBag.DoneCount)</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3 text-end">
                    <button type="submit" class="btn btn-sm btn-primary">Áp dụng</button>
                    @if (!string.IsNullOrEmpty(currentSearch) || currentTrangThai != "All")
                    {
                        <a asp-action="Index" asp-route-viewMode="table" class="btn btn-sm btn-light border text-muted ms-1">Đặt lại</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-xs">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 60px;">ID</th>
                            <th>Phân loại</th>
                            <th>Tiêu đề / Công việc</th>
                            <th>Thiết bị / Model</th>
                            <th>Serial Number</th>
                            <th>Người thực hiện</th>
                            <th>Ngày dự kiến / Làm</th>
                            <th>Chi phí</th>
                            <th>Trạng thái</th>
                            <th class="actions-col pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                    Không tìm thấy dữ liệu bảo trì nào phù hợp.
                                    <div class="mt-2">
                                        <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Tạo phiếu bảo trì mới
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.LoaiHanhDong</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-dark text-decoration-none hover-primary">
                                            @(item.TieuDe ?? item.LoaiHanhDong)
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.ChiTiet))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 240px;" title="@item.ChiTiet">
                                                @item.ChiTiet
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(item.LinhKienThayThe))
                                        {
                                            <div class="small text-primary mt-1">
                                                <i class="bi bi-cpu me-1"></i>Linh kiện: @item.LinhKienThayThe
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@(item.Model ?? "—")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border">@(item.SerialNumber ?? "—")</span>
                                    </td>
                                    <td>
                                        <span class="small text-dark">@(item.NguoiThucHien ?? "—")</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.NgayDuKien))
                                        {
                                            <div class="small text-muted">
                                                <i class="bi bi-calendar-event me-1 text-warning"></i>DK: <span class="font-monospace">@item.NgayDuKien</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(item.NgayThucHien))
                                        {
                                            <div class="small text-success">
                                                <i class="bi bi-calendar-check me-1"></i>Xong: <span class="font-monospace">@item.NgayThucHien</span>
                                            </div>
                                        }
                                        @if (string.IsNullOrEmpty(item.NgayDuKien) && string.IsNullOrEmpty(item.NgayThucHien))
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ChiPhi > 0)
                                        {
                                            <span class="fw-semibold text-dark">@string.Format("{0:N0} đ", item.ChiPhi)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0 đ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "Hoàn thành")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Hoàn thành
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đang xử lý")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                <i class="bi bi-gear-wide-connected me-1"></i>Đang xử lý
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                <i class="bi bi-clock-history me-1"></i>Kế hoạch
                                            </span>
                                        }
                                    </td>
                                    <td class="actions-col pe-4">
                                        <div class="table-actions">
                                            @if (item.TrangThai != "Hoàn thành")
                                            {
                                                <form asp-action="QuickComplete" asp-route-id="@item.Id" method="post" class="d-inline" title="Đánh dấu hoàn thành ngay">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="btn btn-outline-success" onclick="return confirm('Xác nhận đánh dấu hoàn thành phiếu bảo trì này?')">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
