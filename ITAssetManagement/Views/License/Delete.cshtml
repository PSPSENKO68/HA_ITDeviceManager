@model ITAssetManagement.Models.License

@{
    ViewData["Title"] = "Xác nhận xóa License";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận Xóa Bản quyền / License
                </h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="avatar bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.8rem;">
                    <i class="bi bi-trash"></i>
                </div>
                <h5 class="fw-bold text-dark">Bạn có chắc chắn muốn xóa License này?</h5>
                <p class="text-muted">Hành động này sẽ xóa dữ liệu cấp phát bản quyền khỏi danh mục hệ thống.</p>

                <div class="bg-light p-3 rounded text-start my-3">
                    <div class="row g-2">
                        <div class="col-sm-4 text-muted">Người sở hữu:</div>
                        <div class="col-sm-8 fw-bold text-dark">@(Model.Owner ?? "Chưa rõ")</div>

                        <div class="col-sm-4 text-muted">Computer Name:</div>
                        <div class="col-sm-8 font-monospace">@(Model.ComputerName ?? "—")</div>

                        <div class="col-sm-4 text-muted">Global Domain:</div>
                        <div class="col-sm-8">@(Model.GlobalDomain ?? "—")</div>

                        <div class="col-sm-4 text-muted">Active Account:</div>
                        <div class="col-sm-8 font-monospace text-primary">@(Model.ActiveAccount ?? "—")</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Xác nhận Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

