@model ITAssetManagement.Models.License

@{
    ViewData["Title"] = "Cấp mới Bản quyền / License";
    var users = ViewBag.Users as List<ITAssetManagement.Models.User> ?? new List<ITAssetManagement.Models.User>();
    var devices = ViewBag.Devices as List<string> ?? new List<string>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-key-fill me-2"></i>Cấp mới Bản quyền / License
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gán cho Nhân sự (Users)</label>
                            <select asp-for="UserId" class="form-select" id="userSelect" onchange="onUserChanged()">
                                <option value="">-- Chọn nhân sự (Tùy chọn) --</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" data-fullname="@u.FullName" data-dept="@u.Department" data-email="@u.Email" selected="@(Model.UserId == u.Id)">
                                        @u.FullName (@u.Username) - @u.Department
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Owner" class="form-label fw-semibold">Người sở hữu (Owner) <span class="text-danger">*</span></label>
                            <input asp-for="Owner" class="form-control" id="ownerInput" required placeholder="Nhập tên người sở hữu..." />
                            <span asp-validation-for="Owner" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhongBan" class="form-label fw-semibold">Bộ phận / Phòng ban</label>
                            <input asp-for="PhongBan" class="form-control" id="deptInput" placeholder="Ví dụ: P. Kinh Doanh..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ComputerName" class="form-label fw-semibold">Tên máy / Model máy tính</label>
                            <input asp-for="ComputerName" class="form-control" list="deviceList" placeholder="Ví dụ: PC-IT-01..." />
                            <datalist id="deviceList">
                                @foreach (var dev in devices)
                                {
                                    <option value="@dev" />
                                }
                            </datalist>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="GlobalDomain" class="form-label fw-semibold">Global Domain (Email)</label>
                            <input asp-for="GlobalDomain" class="form-control" id="emailInput" placeholder="user@hagroup.vn..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LocalDomain" class="form-label fw-semibold">Local Domain (Nội bộ)</label>
                            <input asp-for="LocalDomain" class="form-control" placeholder="user@local.domain..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ActiveAccount" class="form-label fw-semibold">Tài khoản Active Office / M365</label>
                            <input asp-for="ActiveAccount" class="form-control" placeholder="Tài khoản kích hoạt Office..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="KichHoat" class="form-label fw-semibold">Trạng thái kích hoạt</label>
                            <select asp-for="KichHoat" class="form-select">
                                <option value="Enabled">Enabled (Đang hoạt động)</option>
                                <option value="Disabled">Disabled (Đã khóa / Thu hồi)</option>
                                <option value="Pending">Pending (Chờ duyệt)</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Lưu bản quyền</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onUserChanged() {
            var select = document.getElementById('userSelect');
            var selectedOption = select.options[select.selectedIndex];
            if (selectedOption && selectedOption.value) {
                var name = selectedOption.getAttribute('data-fullname');
                var dept = selectedOption.getAttribute('data-dept');
                var email = selectedOption.getAttribute('data-email');
                if (name) document.getElementById('ownerInput').value = name;
                if (dept) document.getElementById('deptInput').value = dept;
                if (email) document.getElementById('emailInput').value = email;
            }
        }
    </script>
}

