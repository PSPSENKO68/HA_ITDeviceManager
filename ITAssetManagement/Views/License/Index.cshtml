@model IEnumerable<ITAssetManagement.Models.License>
@using ITAssetManagement.Models

@{
    ViewData["Title"] = "Bản quyền & License";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string currentKichHoat = ViewBag.CurrentKichHoat ?? "All";
    string currentAccount = ViewBag.CurrentAccount ?? "";
    
    var accountStats = ViewBag.AccountStats as List<LicenseUsageStat> ?? new List<LicenseUsageStat>();
    int totalAccounts = ViewBag.TotalAccounts ?? accountStats.Count;
    int overLimitCount = ViewBag.OverLimitCount ?? accountStats.Count(s => s.IsOverLimit);
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-key me-2 text-primary"></i>Danh mục Bản quyền & License
        </h3>
        <p class="text-muted small mb-0">Theo dõi tài khoản Microsoft 365, Active Office, Global Domain & Local Domain của nhân sự</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Cấp License mới
        </a>
    </div>
</div>

<!-- Apple Stat Cards (4 Cards) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-key-fill"></i>
            </div>
            <div>
                <div class="stat-label">Tổng số License đã cấp</div>
                <div class="stat-value">@ViewBag.TotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="stat-label">Đang kích hoạt (Enabled)</div>
                <div class="stat-value text-success">@ViewBag.EnabledCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon amber">
                <i class="bi bi-slash-circle-fill"></i>
            </div>
            <div>
                <div class="stat-label">Chưa kích hoạt / Khóa</div>
                <div class="stat-value text-warning">@ViewBag.DisabledCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card @(overLimitCount > 0 ? "border-danger" : "")">
            <div class="stat-icon @(overLimitCount > 0 ? "red" : "green")">
                <i class="bi @(overLimitCount > 0 ? "bi-exclamation-triangle-fill" : "bi-shield-check")"></i>
            </div>
            <div>
                <div class="stat-label">Vượt hạn mức (&gt; 10 máy)</div>
                <div class="stat-value @(overLimitCount > 0 ? "text-danger" : "text-success")">
                    @overLimitCount <span class="fs-6 fw-normal text-muted">/ @totalAccounts acc</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LICENSE USAGE RATIO DASHBOARD (TỐI ĐA 10 MÁY/TÀI KHOẢN) -->
<div class="card border-0 mb-4 shadow-sm" style="background: #ffffff; border-radius: var(--radius-lg); border: 1px solid var(--border-default) !important;">
    <div class="card-body p-4">
        <!-- Dashboard Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 13.5px; letter-spacing: 0.5px;">
                    TỈ LỆ SỬ DỤNG LICENSE (TỐI ĐA 10 MÁY/TÀI KHOẢN)
                </h5>
                @if (overLimitCount > 0)
                {
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: 11px; font-weight: 600;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>@overLimitCount tài khoản vượt mức
                    </span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary active" id="btnFilterAll" onclick="filterDashboardCards('all')">
                        Tất cả (@totalAccounts)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnFilterOver" onclick="filterDashboardCards('over')">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Chỉ xem vượt (@overLimitCount)
                    </button>
                </div>
                <span class="badge rounded-pill text-secondary border px-3 py-1" style="background-color: #f2f2f7; font-size: 12px; font-weight: 600;">
                    @totalAccounts tài khoản
                </span>
            </div>
        </div>

        <!-- Scrollable Dashboard Grid -->
        <div class="license-dashboard-grid" id="licenseDashboardGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 14px 20px; max-height: 280px; overflow-y: auto; padding: 4px 6px 6px 2px;">
            @foreach (var stat in accountStats)
            {
                bool isOver = stat.IsOverLimit;
                double percent = Math.Min((stat.Count / 10.0) * 100.0, 100.0);
                string borderColor = isOver ? "#ff3b30" : "var(--border-default)";
                string progressColor = isOver ? "#ff3b30" : "var(--color-primary)";
                string cardBg = isOver ? "#fff9f9" : "#ffffff";

                <div class="license-stat-card @(isOver ? "card-over-limit" : "") @(currentAccount == stat.ActiveAccount ? "card-selected" : "")"
                     data-account="@stat.ActiveAccount"
                     data-is-over="@(isOver ? "true" : "false")"
                     onclick="toggleAccountFilter('@stat.ActiveAccount')"
                     title="Nhấp để lọc danh sách các máy sử dụng tài khoản @stat.ActiveAccount"
                     style="background: @cardBg; padding: 15px 18px; border-radius: var(--radius-lg); border: 1.5px solid @borderColor; cursor: pointer; transition: all 0.2s ease; position: relative;">
                    
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2" style="max-width: 68%; overflow: hidden;">
                            @if (isOver)
                            {
                                <i class="bi bi-exclamation-circle-fill text-danger flex-shrink-0" style="font-size: 14px;"></i>
                            }
                            else
                            {
                                <i class="bi bi-microsoft text-primary opacity-75 flex-shrink-0" style="font-size: 13px;"></i>
                            }
                            <strong class="text-truncate" style="font-size: 14px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.2px;" title="@stat.ActiveAccount">
                                @stat.ActiveAccount
                            </strong>
                        </div>
                        <span style="font-size: 13px; font-weight: 700; color: @(isOver ? "#ff3b30" : "var(--text-muted)");">
                            @(isOver ? $"Vượt: {stat.Count}/10" : $"{stat.Count}/10 ({Math.Round(percent)}%)")
                        </span>
                    </div>

                    <!-- Progress Bar Track -->
                    <div style="height: 6px; background: rgba(0,0,0,0.06); border-radius: 3px; overflow: hidden;">
                        <div style="height: 100%; width: @(isOver ? "100" : percent.ToString("0"))%; background: @progressColor; border-radius: 3px; transition: width 0.3s ease;"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Active Filter Banner (Shown when an account is clicked) -->
<div id="activeFilterBanner" class="alert alert-info py-2 px-3 mb-3 d-flex justify-content-between align-items-center shadow-sm @(string.IsNullOrEmpty(currentAccount) ? "d-none" : "")" 
     style="background-color: var(--color-primary-light); border-color: rgba(226, 114, 66, 0.3); border-radius: var(--radius-md);">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-funnel-fill text-primary"></i>
        <span>Đang lọc theo tài khoản: <strong id="filterAccountName" class="font-monospace text-dark">@currentAccount</strong></span>
        <span id="filteredRowCountBadge" class="badge rounded-pill bg-white text-primary border ms-1"></span>
    </div>
    <button type="button" class="btn btn-sm btn-light border text-danger py-0 px-2" onclick="clearAccountFilter()">
        <i class="bi bi-x me-1"></i>Bỏ lọc
    </button>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 mb-3 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="mainFilterForm" class="row g-2 align-items-center">
            <input type="hidden" name="account" id="hiddenAccountInput" value="@currentAccount" />
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" id="mainSearchInput" class="form-control border-start-0 ps-0" 
                           placeholder="Tìm Người sở hữu, Computer Name, Email, Bộ phận..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="kichHoat" class="form-select form-select-sm">
                    <option value="All" selected="@(currentKichHoat == "All")">-- Tất cả trạng thái --</option>
                    <option value="Enabled" selected="@(currentKichHoat == "Enabled")">Enabled (Đang dùng)</option>
                    <option value="Disabled" selected="@(currentKichHoat == "Disabled")">Disabled (Đã khóa)</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentKichHoat != "All" || !string.IsNullOrEmpty(currentAccount))
                {
                    <a asp-action="Index" class="btn btn-sm btn-light border text-muted ms-1">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="licenseTable">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 50px;">STT</th>
                        <th>Người sở hữu (Owner)</th>
                        <th>Bộ phận</th>
                        <th>Computer Name / Model</th>
                        <th>Global Domain (Email)</th>
                        <th>Local Domain</th>
                        <th>Tài khoản Active Office</th>
                        <th>Trạng thái</th>
                        <th class="actions-col pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="licenseTableBody">
                    @if (!Model.Any())
                    {
                        <tr id="emptyTableRow">
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                Không tìm thấy bản quyền nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int idx = 0;
                        foreach (var l in Model)
                        {
                            idx++;
                            string acc = (l.ActiveAccount ?? "").Trim();
                            var stat = accountStats.FirstOrDefault(s => s.ActiveAccount == acc);
                            bool isOver = stat != null && stat.IsOverLimit;

                            <tr class="license-data-row" data-account="@acc" data-owner="@(l.Owner ?? "")" data-computer="@(l.ComputerName ?? "")">
                                <td class="ps-4 fw-semibold text-muted">@(l.Stt ?? idx)</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@l.Id" class="fw-semibold text-dark text-decoration-none">
                                        @(l.Owner ?? "—")
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@(l.PhongBan ?? "—")</span>
                                </td>
                                <td>
                                    <span class="font-monospace text-dark fw-semibold">@(l.ComputerName ?? "—")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(l.GlobalDomain))
                                    {
                                        <a href="mailto:@l.GlobalDomain" class="text-decoration-none small text-muted">@l.GlobalDomain</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="font-monospace text-muted small">@(l.LocalDomain ?? "—")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(acc))
                                    {
                                        if (isOver)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace px-2 py-1" 
                                                  title="Tài khoản này đang vượt định mức (@stat!.Count/10 máy)">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@acc
                                                <strong class="ms-1">(@stat.Count/10)</strong>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark font-monospace border px-2 py-1">@acc</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (l.KichHoat == "Enabled" || l.KichHoat == "Kích hoạt" || l.KichHoat == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>Enabled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@(l.KichHoat ?? "Disabled")</span>
                                    }
                                </td>
                                <td class="actions-col pe-4">
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@l.Id" class="btn btn-outline-primary" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-light border" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@l.Id" class="btn btn-light border text-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .license-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    }
    .license-stat-card.card-selected {
        outline: 2px solid var(--color-primary);
        box-shadow: 0 0 0 4px rgba(226, 114, 66, 0.2);
    }
    .stat-card.border-danger {
        border-color: rgba(220, 53, 69, 0.4) !important;
    }
    .stat-icon.red {
        background-color: rgba(220, 53, 69, 0.12);
        color: #dc3545;
    }
</style>

@section Scripts {
<script>
    let activeFilterAccount = "@currentAccount";

    // Lọc danh sách thẻ trên dashboard: Tất cả hoặc Chỉ xem vượt
    function filterDashboardCards(mode) {
        const cards = document.querySelectorAll('.license-stat-card');
        const btnAll = document.getElementById('btnFilterAll');
        const btnOver = document.getElementById('btnFilterOver');

        if (mode === 'over') {
            btnOver.classList.add('active');
            btnAll.classList.remove('active');
            cards.forEach(c => {
                if (c.getAttribute('data-is-over') === 'true') {
                    c.style.display = '';
                } else {
                    c.style.display = 'none';
                }
            });
        } else {
            btnAll.classList.add('active');
            btnOver.classList.remove('active');
            cards.forEach(c => c.style.display = '');
        }
    }

    // Nhấp vào thẻ tài khoản để lọc bảng bên dưới
    function toggleAccountFilter(account) {
        if (activeFilterAccount === account) {
            clearAccountFilter();
            return;
        }

        activeFilterAccount = account;
        applyClientTableFilter(account);
    }

    function applyClientTableFilter(account) {
        // Highlight card
        document.querySelectorAll('.license-stat-card').forEach(c => {
            if (c.getAttribute('data-account') === account) {
                c.classList.add('card-selected');
            } else {
                c.classList.remove('card-selected');
            }
        });

        // Show banner
        const banner = document.getElementById('activeFilterBanner');
        const nameEl = document.getElementById('filterAccountName');
        const countBadge = document.getElementById('filteredRowCountBadge');
        banner.classList.remove('d-none');
        nameEl.innerText = account;

        // Filter rows
        const rows = document.querySelectorAll('.license-data-row');
        let visibleCount = 0;
        rows.forEach(r => {
            const rowAcc = r.getAttribute('data-account');
            if (rowAcc === account) {
                r.style.display = '';
                visibleCount++;
            } else {
                r.style.display = 'none';
            }
        });

        countBadge.innerText = visibleCount + ' thiết bị/người dùng';

        // Update hidden form input
        const hiddenInput = document.getElementById('hiddenAccountInput');
        if (hiddenInput) hiddenInput.value = account;
    }

    function clearAccountFilter() {
        activeFilterAccount = "";
        
        // Remove highlight
        document.querySelectorAll('.license-stat-card').forEach(c => c.classList.remove('card-selected'));

        // Hide banner
        const banner = document.getElementById('activeFilterBanner');
        banner.classList.add('d-none');

        // Show all rows
        document.querySelectorAll('.license-data-row').forEach(r => r.style.display = '');

        const hiddenInput = document.getElementById('hiddenAccountInput');
        if (hiddenInput) hiddenInput.value = "";
    }

    // Tự động kích hoạt nếu đã có account từ server URL
    document.addEventListener('DOMContentLoaded', function () {
        if (activeFilterAccount) {
            applyClientTableFilter(activeFilterAccount);
        }
    });
</script>
}
